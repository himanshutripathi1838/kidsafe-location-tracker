# Port configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database config (Requires PostGIS extension)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=kids_location_tracker
DB_USER=postgres
DB_PASS=postgres

# JWT details
JWT_SECRET=YOUR_SUPER_SECRET_JWT_PASSPHRASE_HERE
JWT_EXPIRES_IN=30d

# Twilio Credentials (SMS and Emergency Voice Calls)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+12345678901

# Firebase credentials (Relative or absolute path to FCM service account file)
# Obtain this from Firebase Console > Project Settings > Service Accounts
FIREBASE_CREDENTIALS_PATH=./config/firebase-service-account.json

# AWS S3 Storage (For daily travel logs PDF exports)
S3_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
S3_BUCKET_NAME=kids-tracker-reports-bucket
S3_REGION=ap-south-1
