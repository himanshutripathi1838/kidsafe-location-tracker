# Kids Location Tracker Mobile App - Environment Variables

# Backend server API URL
API_URL=http://10.0.2.2:5000/api

# Backend Socket.IO Server URL
SOCKET_URL=http://10.0.2.2:5000

# Google Maps API Key for Android
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Firebase Sender ID for Push Notifications
FIREBASE_SENDER_ID=YOUR_FIREBASE_SENDER_ID_HERE
